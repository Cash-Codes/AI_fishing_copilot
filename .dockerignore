# ─── Version control ───────────────────────────────────────────────────────────
.git
.gitignore

# ─── Environment files (never bake secrets into the image) ─────────────────────
.env
.env.local
.env.*.local
backend/.env

# ─── Python ────────────────────────────────────────────────────────────────────
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
backend/.pytest_cache
backend/htmlcov
backend/.coverage
.mypy_cache

# ─── Node / Next.js ────────────────────────────────────────────────────────────
node_modules
frontend/node_modules
frontend/.next
frontend/.turbo

# ─── Tests (not needed in the image) ──────────────────────────────────────────
backend/tests
frontend/app/components/__tests__
frontend/lib/__tests__

# ─── Docs & local config ───────────────────────────────────────────────────────
docs
*.md
.claude

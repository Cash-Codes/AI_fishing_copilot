# ─── Frontend ─────────────────────────────────────────────────────────────────

# The public URL where the frontend is served (no trailing slash)
FRONTEND_URL=http://localhost:3000

# The backend API base URL that the frontend calls
VITE_API_BASE_URL=http://localhost:8000


# ─── Backend ──────────────────────────────────────────────────────────────────

# Host and port the backend server listens on
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Secret key used for signing tokens — replace with a long random string
SECRET_KEY=change_me_to_a_long_random_string

# Allowed origins for CORS (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=http://localhost:3000


# ─── Google Cloud / Vertex AI ─────────────────────────────────────────────────

# Your GCP project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# GCP region where your Vertex AI resources live
GOOGLE_CLOUD_REGION=us-central1

# Path to your service account key file (keep this OUT of the repo)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# Vertex AI model endpoint or model ID to use
VERTEX_AI_MODEL=gemini-1.5-pro


# ─── FAISS / Vector Store ─────────────────────────────────────────────────────

# Directory where FAISS index files are stored (relative or absolute)
FAISS_INDEX_DIR=./data/faiss_index

# Name of the primary index file inside FAISS_INDEX_DIR
FAISS_INDEX_NAME=fishing_knowledge.faiss

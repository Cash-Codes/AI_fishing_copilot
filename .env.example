# ─── Frontend ─────────────────────────────────────────────────────────────────
# Copy the relevant lines below into frontend/.env.local (Next.js reads that
# file automatically; it must live inside the frontend/ directory).
#
# NEXT_PUBLIC_ vars are baked into the JS bundle at build time.
#
# Local dev:   set to http://localhost:8000 (direct to uvicorn)
# Docker/prod: leave unset or set to /api — nginx proxies /api/* to uvicorn
#              on the same origin, so no absolute URL is needed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# ─── Backend ──────────────────────────────────────────────────────────────────
# Copy these into backend/.env (or the working directory you run uvicorn from).

# Host and port the backend server listens on
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Origins the backend will accept requests from (comma-separated).
# Local dev: http://localhost:3000
# Docker/prod: same-origin requests come via nginx, so CORS is not exercised
#              by the frontend — but add your public URL here for direct API
#              access (e.g. from Swagger UI or external clients).
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.run.app
CORS_ALLOWED_ORIGINS=http://localhost:3000


# ─── Google Cloud / Vertex AI ─────────────────────────────────────────────────
#
# Without GOOGLE_CLOUD_PROJECT the backend generates template explanations.
# With it set the app calls Vertex AI Gemini for AI-generated explanations.

# GCP project that has Vertex AI API enabled
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Region for Vertex AI API calls (us-central1 has the widest model availability)
GOOGLE_CLOUD_REGION=us-central1

# Gemini model to use for explanation generation
# Options: gemini-2.5-flash  gemini-2.5-flash-lite  gemini-2.5-flash
VERTEX_AI_MODEL=gemini-2.5-flash

# ─── Frontend ─────────────────────────────────────────────────────────────────

# The public URL where the frontend is served (no trailing slash)
FRONTEND_URL=http://localhost:3000

# The backend API base URL that the frontend calls
VITE_API_BASE_URL=http://localhost:8000


# ─── Backend ──────────────────────────────────────────────────────────────────

# Host and port the backend server listens on
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Secret key used for signing tokens — replace with a long random string
SECRET_KEY=change_me_to_a_long_random_string

# Allowed origins for CORS (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=http://localhost:3000


# ─── Google Cloud / Vertex AI ─────────────────────────────────────────────────
#
# Without GOOGLE_CLOUD_PROJECT the backend generates template explanations.
# With it set the app calls Vertex AI Gemini for AI-generated explanations.
#
# Authentication (choose one):
#   Option A — service account key file (recommended for local dev):
#     GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json
#
#   Option B — Application Default Credentials (recommended for prod/GCE):
#     Run: gcloud auth application-default login
#     Leave GOOGLE_APPLICATION_CREDENTIALS unset.

# GCP project that has Vertex AI API enabled
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Region for Vertex AI API calls (us-central1 has the widest model availability)
GOOGLE_CLOUD_REGION=us-central1

# Gemini model to use for explanation generation
# Options: gemini-2.5-flash  gemini-2.5-flash-lite  gemini-1.5-pro
VERTEX_AI_MODEL=gemini-2.5-flash

# Path to service account JSON key — never commit this file to the repo
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json
